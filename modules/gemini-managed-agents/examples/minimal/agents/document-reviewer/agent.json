{
  "api_version": "agents.selamy.dev/v1alpha1",
  "kind": "ManagedAgent",
  "metadata": {
    "name": "document-reviewer",
    "labels": {
      "environment": "example"
    },
    "annotations": {
      "owner": "documentation"
    }
  },
  "spec": {
    "backend": "gemini_developer_api",
    "active_revision": "v1",
    "revisions": {
      "v1": {
        "directory": "revisions/v1",
        "description": "Reviews a supplied document against explicit criteria.",
        "system_instruction": "instructions/system.md",
        "base_agent": "antigravity-preview-05-2026",
        "model": "gemini-3.7-flash",
        "max_total_tokens": 120000,
        "builtin_tools": [],
        "mcp_servers": [],
        "network": {
          "mode": "disabled"
        },
        "output_schema": "schemas/output.schema.json",
        "evaluation_cases": [],
        "lifecycle": {
          "deletion_policy": "delete",
          "reconcile_generation": 0
        }
      }
    }
  }
}
